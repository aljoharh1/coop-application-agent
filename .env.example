# Required — at least one LLM key for keyword extraction & CV summaries
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Telegram discovery agent
# TG_API_ID=
# TG_API_HASH=

# Optional — override candidate details via environment (profile.json is preferred)
# COOP_NAME=Jane Doe
# COOP_EMAIL=jane.doe@example.com
# COOP_PHONE=+1234567890
# COOP_GPA=3.50
# COOP_GPA_SCALE=5
# COOP_START_DATE=2026-12-20
# COOP_END_DATE=2027-06-17

# Optional — behaviour flags
# COOP_NO_ASK=1          # skip terminal prompts for unknown fields
# COOP_AUTO_ADVANCE=1    # auto-click Next in multi-step wizards

# Optional — override document filenames in my_docs/
# COOP_DOC_TRANSCRIPT=transcript.pdf
# COOP_DOC_NATIONAL_ID=national_id.pdf
# COOP_DOC_IBAN=iban_letter.pdf
# COOP_DOC_UNI_LETTER=university_letter.pdf
